# Server env file for deploy/compose.prod.yaml.
# Copy to /opt/pulse/.env on the VPS, fill in real values, then: chmod 600 .env
# Never commit the real .env.

# --- Postgres (used by the db container) ---
POSTGRES_DB=pulse
POSTGRES_USER=pulse
# Make a long random one, e.g.: openssl rand -hex 32
POSTGRES_PASSWORD=change-me

# --- Spring Boot (used by the api container) ---
# "db" is the Postgres service name inside the pulse network.
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/pulse
# These copy the Postgres values above, so you set them only once.
SPRING_DATASOURCE_USERNAME=${POSTGRES_USER}
SPRING_DATASOURCE_PASSWORD=${POSTGRES_PASSWORD}

# Shared secret: the Vercel route handler sends it in the X-Pulse-Proxy-Secret
# header, and /api/** answers 403 without it. Required: the API does not start
# without it. Make one with: openssl rand -hex 32
# Put the SAME value in the Vercel project as a server-only env var
# (never a NEXT_PUBLIC_* one).
APP_PROXY_SECRET=change-me

# --- Deploy ---
# Image tag to run: "latest" or a short git sha (for a rollback).
# The deploy workflow sets this for each deploy.
IMAGE_TAG=latest
# Host port for the API. Must be free on the VPS (8090 is Spine's).
PULSE_API_PORT=8091
# Address the API port listens on. 0.0.0.0 = public (TEMPORARY, so Vercel can
# proxy to it). Use 127.0.0.1 once a Cloudflare Tunnel + domain is in front.
PULSE_API_BIND=0.0.0.0
