# The environment variables the app reads. Spring Boot does not load a .env file:
# set these in your shell, IDE or run configuration. The local defaults below match
# compose.yaml, so for plain local dev you can leave them unset.

# Spring profile: leave empty for local, use "prod" in production.
SPRING_PROFILES_ACTIVE=

# Database (local defaults match compose.yaml)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/pulse
SPRING_DATASOURCE_USERNAME=pulse
SPRING_DATASOURCE_PASSWORD=pulse

# HTTP port
SERVER_PORT=8080

# Shared secret the Vercel route handler sends as the X-Pulse-Proxy-Secret header.
# Empty locally = the check is off (a log line says so at startup).
# Required in production. Make one with: openssl rand -hex 32
APP_PROXY_SECRET=
